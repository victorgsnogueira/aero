# =============================================================================
# aero — configuração de exemplo (sem segredos).
# Copie para `.env` e preencha. Gere segredos com:  node infra/scripts/gen-secrets.mjs
# Configurações comerciais (nome, empresa, mensagens, horários, limites) ficam
# no próprio aplicativo, em Configurações.
# =============================================================================

NODE_ENV=production
TZ=UTC
LOG_LEVEL=info

# Porta publicada SOMENTE em 127.0.0.1 para o navegador do proprietário.
AERO_HTTP_PORT=8080

# --- MySQL (um servidor, dois bancos lógicos com usuários distintos) ----------
MYSQL_ROOT_PASSWORD=
AERO_DB_PASSWORD=
WA_DB_PASSWORD=

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=

# --- WA-AKG (gateway WhatsApp) ------------------------------------------------
# Chave de API usada somente pelo backend do aero (nunca vai ao navegador).
WA_GATEWAY_API_KEY=
# Segredo HMAC dos webhooks gateway -> aero.
WA_WEBHOOK_SECRET=
# Segredos internos exigidos pelo WA-AKG.
WA_AUTH_SECRET=
WA_ADMIN_EMAIL=owner@aero.local
WA_ADMIN_PASSWORD=
WA_SESSION_ID=aero-main
# Porta do painel do WA-AKG (diagnóstico). Vazio = não publicar.
WA_PANEL_PORT=

# --- Envio de mensagens -------------------------------------------------------
# Interruptor global. Mantenha false até configurar e revisar tudo.
SENDING_ENABLED=false
# Opcional: se preenchido, SOMENTE estes números (E.164, separados por vírgula)
# podem receber mensagens. Use durante testes com números seus.
SEND_ALLOWLIST=

# --- Desenvolvimento (npm run dev fora do Docker) -----------------------------
# Usado apenas quando a API roda no host com compose.dev.yml publicando serviços.
DATABASE_URL=mysql://aero:CHANGE_ME@127.0.0.1:3307/aero
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6380
SCRAPER_URL=http://127.0.0.1:8081
WA_GATEWAY_URL=http://127.0.0.1:3200
WA_WEBHOOK_URL=http://host.docker.internal:3100/api/webhooks/wa
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
