{
  "name": "@aero/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "node --watch --env-file-if-exists=../../.env src/worker.ts",
    "start": "node src/server.ts",
    "start:worker": "node src/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts",
    "seed:demo": "node --env-file-if-exists=../../.env src/db/seed-demo.ts",
    "openapi": "node --env-file-if-exists=../../.env src/scripts/export-openapi.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "node --env-file-if-exists=../../.env --test --test-concurrency=1 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@aero/shared": "*",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/sensible": "6.0.7",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@fastify/type-provider-typebox": "6.3.0",
    "bullmq": "5.81.5",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-plugin": "5.1.0",
    "ioredis": "5.11.1",
    "libphonenumber-js": "1.13.15",
    "mysql2": "3.24.6",
    "pino": "10.4.0",
    "typebox": "1.4.1"
  },
  "devDependencies": {
    "@aero/mcp": "*",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "typescript": "6.0.3"
  }
}
